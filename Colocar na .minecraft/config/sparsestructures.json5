// ### THE MOD REQUIRES A RESTART OF THE GAME TO APPLY CHANGES ###
{
  // this is the main spread factor (default is 2)
  //
  // tips: a spread factor can be a decimal number (such as 1.5)
  //       a spread factor of 1 means all structure's placements are not modified (useful if you want to use only custom spread factors)
  //       a spread factor above 1 means all structures are rarer
  //       a spread factor below 1 means all structures are more common
  //       a spread factor of 0 disables all structures entirely
  //
  // Hearthbound: 2 -> 1.5 -> 1 -> 1.25 -> 2 -> **1.25** again on 2026-08-08.
  // Set back to 1.25 after the user reported barely finding structures while exploring a server.
  // At 2 every structure was twice as rare as its mod intends, which is the strongest thinning the
  // mod offers; combined with 38 structure namespaces spread over a 150-weight TerraBlender
  // Overworld it made exploration feel empty rather than curated. 1.25 keeps a mild anti-crowding
  // bias while restoring roughly 60% more structures per unit area than 2 did.
  "spreadFactor": 1.25,

  // Some structure mods/datapacks do not specify a custom salt or use the same salt for all their structures, which might cause structure overlap.
  // Enabling this is supposed to reduce this phenomenon, as all structure sets will have their own salt, hashed from their id.
  // If unsure, leave this enabled.
  //
  // Hearthbound: with 38 structure namespaces in the pack, per-id salting is what keeps different
  // mods' structures from landing on top of one another, so leave it on.
  "idBasedSalt": true,

  // this is a list of custom spread factors
  "customSpreadFactors": [
    // example of the mansion being doubled in rarity (the mod's default)
    // Hearthbound: left at the mod's shipped default. With the global back at 1.25 this entry is
    // meaningful again — mansions stay at 2x rarity while everything else loosens to 1.25x.
    {
      "structure": "minecraft:mansion",
      "factor": 2
    },
    // --- Villages: exempt from the global factor (added 2026-08-22) ---
    // Luki's Grand Capitals OVERRIDES data/minecraft/worldgen/structure_set/villages.json and sets
    // spacing 50 / separation 35, against vanilla's 34 / 8. The global 1.25 was then multiplying
    // that again to roughly 62 / 43, making villages about 3.3x rarer BY AREA than vanilla -
    // which is why they had become hard to find at all. Factor 1 stops the compounding and leaves
    // villages at the spacing LGC actually intends for its larger capitals.
    {
      "structure": "minecraft:villages",
      "factor": 1
    },
    // --- Aether dimension: exempt from the global factor (factor 1 = placements unmodified) ---
    // The Aether is a dimension you travel to deliberately rather than wander through, so the global
    // rarity multiplier only made a short visit feel empty. Still meaningful at a global 1.25.
    // (Kept at 1 across the 2->1.25 change: the Aether should stay at mod-intended density.)
    // All four sets gate on #aether:is_aether (the 4 skyroot biomes), so they cannot affect the Overworld.
    {
      "structure": "explore_ruins_aether:aether_structures",
      "factor": 1
    },
    {
      "structure": "aether:bronze_dungeon",
      "factor": 1
    },
    {
      "structure": "aether:silver_and_gold_dungeons",
      "factor": 1
    },
    {
      "structure": "aether:large_aercloud",
      "factor": 1
    },
    // add the structures you want to modify in the format:
    // (don't forget to remove "//", and use dots for decimal numbers)
    //
    // {
    //     "structure": "namespace:structure_name",
    //     "factor": number
    // },
    //
    // where "structure" is a structure_set or the name of a structure
    // /!\ if you put the name of a structure, all structures in its set will be modified
    // (example: "minecraft:village_plains" will modify all structures in the "villages" set)
    // see https://minecraft.wiki/w/Tutorials/Custom_structures#Structure_Set for more info
    //
    // tip: you can dump all structure sets in a file by running the custom command /dumpstructuresets
    // tip: the same spread factors rules apply here (set to 0 to disable said structure)
  ]
}
